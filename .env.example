# Groq API — get free key at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# SharedMENN MCP server URL
# Local: http://localhost:8765/mcp
# Or your deployed SharedMENN URL
SHAREDMENN_URL=

# Bearer token SharedMENN's HTTP server is using (auto-generated on first
# run, printed at startup, and persisted to sharedmennmem/.shared_menn/http_token)
SHAREDMENN_TOKEN=

# PostgreSQL connection string
# Docker Compose: postgresql://postgres:postgres@postgres:5432/mennbridge
DATABASE_URL=

# Project identifier — used to scope all memories
MENNBRIDGE_PROJECT=

# Server port (default 8001)
PORT=8001
